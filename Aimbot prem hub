-- drag toggleFrame
do
    local dragging = false
    local dragStart = Vector2.new()
    local startPos = Vector2.new()
    toggleFrame.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = UIS:GetMouseLocation()
            startPos = Vector2.new(toggleFrame.Position.X.Offset, toggleFrame.Position.Y.Offset)
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = UIS:GetMouseLocation() - dragStart
            toggleFrame.Position = UDim2.new(0, startPos.X + delta.X, 0, startPos.Y + delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

-- utility: find hit part (tries common names)
local function getHitpart(character)
    local names = {"HumanoidRootPart","UpperTorso","LowerTorso","Torso","HumanoidRootPart","Head"}
    for _,n in ipairs(names) do
        local p = character:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    -- fallback: first BasePart
    for _,obj in ipairs(character:GetChildren()) do
        if obj:IsA("BasePart") then return obj end
    end
    return nil
end

