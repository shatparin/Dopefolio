-- Tab logic
local function setTab(name)
    catLabel.Text = name
    for k,v in pairs(tabButtons) do
        if k==name then
            v.BackgroundColor3 = Color3.fromRGB(40,40,40)
            v.TextColor3 = Color3.fromRGB(0,255,150)
        else
            v.BackgroundColor3 = Color3.fromRGB(30,30,30)
            v.TextColor3 = Color3.fromRGB(200,200,200)
        end
    end
    local g = (name=="GENERAL")
    speedLabel.Visible = g
    speedInput.Visible = g
    local c = (name=="COMBAT")
    aimbotLabel.Visible = c
    aimbotToggle.Visible = c
    aimbotMark.Visible = (aimbotEnabled and c)
    fovLabel.Visible = c
    fovInput.Visible = c
end

for name,btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function() setTab(name) end)
end
