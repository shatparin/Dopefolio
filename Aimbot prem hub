-- find closest enemy by screen-distance from screen center
local function getClosestEnemyByCenter(fov)
    local cam = Camera
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local closest, minDist = nil, math.huge
    for _, pl in pairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character and pl.Character.Parent and pl.Character:FindFirstChildOfClass("Humanoid") and pl.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local hitpart = getHitpart(pl.Character)
            if hitpart then
                local screenPos, onScreen = cam:WorldToViewportPoint(hitpart.Position)
                if onScreen then
                    local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                    local dist = (screenVec - center).Magnitude
                    if dist <= fov and dist < minDist then
                        minDist = dist
                        closest = pl
                    end
                end
            end
        end
    end
    return closest
end

-- main loop
RunService.RenderStepped:Connect(function()
    -- Speed hack
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
        local n = tonumber(speedInput.Text)
        if n then n = math.clamp(n,1,3.5) end
        if n then
            hum.WalkSpeed = 16 * n
        else
            hum.WalkSpeed = 16
        end
    end

    -- Aimbot + FOV center display
    if aimbotEnabled then
        local raw = tonumber(fovInput.Text) or 300
        local fov = math.clamp(raw, 1, 1000)

        -- update drawing/UI
        if hasDrawing and drawingCircle then
            drawingCircle.Visible = true
            drawingCircle.Radius = fov
            drawingCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        elseif fovGuiFrame then
            fovGuiFrame.Visible = true
            -- Size is diameter: convert pixels
            local size = math.max(2, math.floor(fov * 2))
            fovGuiFrame.Size = UDim2.fromOffset(size, size)
            fovGuiFrame.Position = UDim2.new(0.5,0,0.5,0)
        end

        local target = getClosestEnemyByCenter(fov)
        if target and target.Character and target.Character.Parent then
            local hitpart = getHitpart(target.Character)
            if hitpart then
                -- instant aim (center camera onto hitpart)
                local camPos = Camera.CFrame.Position
                Camera.CFrame = CFrame.new(camPos, hitpart.Position)
            end
        end
    else
        if hasDrawing and drawingCircle then drawingCircle.Visible = false end
        if fovGuiFrame then fovGuiFrame.Visible = false end
    end
end)

