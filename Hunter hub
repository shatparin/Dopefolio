-- ===== Core shooting helpers =====
local function getFOV()
    local val = tonumber(fovBox.Text)
    if val then return math.clamp(val,1,1000) end
    return FOV_VALUE
end

local function tryApplyDamage(hitPart, dmg)
    if not hitPart then return false end
    local model = hitPart:FindFirstAncestorOfClass("Model")
    if model and model ~= player.Character then
        local humanoid = model:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:TakeDamage(dmg)
            return true
        end
    end
    return false
end

local function raycastStep(origin, direction, damage)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    rp.FilterDescendantsInstances = {player.Character}
    local step = direction.Unit * 100
    local result = Workspace:Raycast(origin, step, rp)
    if result then
        tryApplyDamage(result.Instance, damage)
        if WALLPEN_ENABLED then
            return origin + step
        else
            return nil
        end
    else
        return origin + step
    end
end

local function createVisualBullet(size, pos)
    local b = Instance.new("Part")
    b.Shape = Enum.PartType.Ball
    b.Size = size or Vector3.new(0.4,0.4,0.4)
    b.Material = Enum.Material.Neon
    b.Color = Color3.fromRGB(255,80,80)
    b.Anchored = true
    b.CanCollide = false
    b.CFrame = CFrame.new(pos)
    b.Parent = Workspace
    return b
end

-- select nearest player whose head screen pos is within FOV circle (pixels)
local function getNearestPlayerInFOV_byScreen(origin)
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local fovRadius = getFOV()
    local nearest, nearestDist = nil, math.huge
    for _, other in pairs(Players:GetPlayers()) do
        if other ~= player and other.Character and other.Character:FindFirstChild("Head") then
            local head = other.Character.Head
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                local dist = (screenVec - center).Magnitude
                if dist <= fovRadius and dist < nearestDist then
                    nearestDist = dist
                    nearest = other.Character.Head
                end
            end
        end
    end
    return nearest
end

-- spawn homing projectile that aims for head if available
local function spawnHomingProjectile(cfg, origin)
    local speed = cfg.bulletSpeed or 1000
    local damage = cfg.damage or 10
    local bullet = createVisualBullet(cfg.bulletSize or Vector3.new(0.4,0.4,0.4), origin)
    local prevPos = origin
    local alive = true
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not alive then conn:Disconnect() return end
        local targetHead = nil
        if AIMBOT_ENABLED then
            targetHead = getNearestPlayerInFOV_byScreen(origin)
        end
        local curPos = bullet.Position
        local desiredDir
        if targetHead and targetHead.Parent then
            desiredDir = (targetHead.Position - curPos).Unit
        else
            desiredDir = (mouse.Hit.Position - curPos).Unit
        end
        local currentDir = (curPos - prevPos).Magnitude > 0.001 and (curPos - prevPos).Unit or desiredDir
        local newDir = currentDir:Lerp(desiredDir, math.clamp(cfg.turnRate or 1,0,1)).Unit
        local nextPos = raycastStep(curPos, newDir * speed * dt, damage)
        if nextPos then
            bullet.CFrame = CFrame.new(nextPos, nextPos + newDir)
            prevPos = curPos
        else
            alive = false
            bullet:Destroy()
        end
        if (bullet.Position - origin).Magnitude > 5000 then
            alive = false
            bullet:Destroy()
        end
    end)
    Debris:AddItem(bullet, 6)
end

-- shooting connect
local lastFire = 0
local function shootWeapon()
    local cfg = WeaponConfig["Pistol"]
    if tick() - lastFire < (cfg.fireRate or 0.2) then return end
    lastFire = tick()
    if not player.Character or not player.Character:FindFirstChild("Head") then return end
    spawnHomingProjectile(cfg, player.Character.Head.Position)
end
mouse.Button1Down:Connect(shootWeapon)

