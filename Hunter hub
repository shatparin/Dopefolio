-- ===== Helper: createToggle (UI) =====
local function createToggle(parent, yPos, text, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0,100,0,25)
    label.Position = UDim2.new(0,10,0,yPos)
    label.BackgroundTransparency = 1
    label.Text = text
    label.Font = Enum.Font.SourceSansBold
    label.TextScaled = true
    label.TextColor3 = Color3.fromRGB(0,0,0)
    label.Parent = parent

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0,50,0,25)
    toggle.Position = UDim2.new(0,120,0,yPos)
    toggle.Text = "OFF"
    toggle.TextScaled = true
    toggle.BackgroundColor3 = Color3.fromRGB(200,0,0)
    toggle.TextColor3 = Color3.fromRGB(255,255,255)
    toggle.Font = Enum.Font.SourceSansBold
    toggle.Parent = parent

    local state = false
    toggle.MouseButton1Click:Connect(function()
        state = not state
        toggle.Text = state and "ON" or "OFF"
        toggle.BackgroundColor3 = state and Color3.fromRGB(0,200,0) or Color3.fromRGB(200,0,0)
        callback(state)
    end)
    return toggle
end

