-- RenderStepped loop: update ESP boxes and aim line, and FOV circle visibility
RunService.RenderStepped:Connect(function()
    local mousePos = Vector2.new(mouse.X, mouse.Y)
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local nearest, nearestDist = nil, math.huge
    local fovRadius = getFOV()

    -- update FOV circle position & size (in case resolution changes)
    fovCircle.Position = UDim2.new(0.5,0,0.5,0)
    fovCircle.Size = UDim2.new(0, fovRadius*2, 0, fovRadius*2)

    -- update boxes for each player
    for plr, box in pairs(playerBoxes) do
        local char = plr.Character
        if char and char:FindFirstChild("Head") and char:FindFirstChild("HumanoidRootPart") then
            local headPos, onScreenHead = Camera:WorldToViewportPoint(char.Head.Position)
            local rootPos, onScreenRoot = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
            if ESP_ENABLED and onScreenHead and onScreenRoot then
                local height = math.abs(headPos.Y - rootPos.Y)
                height = math.max(30, height)
                local width = math.clamp(height * 0.45, 20, 200)
                box.Size = UDim2.new(0, math.floor(width), 0, math.floor(height))
                box.Position = UDim2.new(0, headPos.X - width/2, 0, headPos.Y - 10)
                box.Visible = true
            else
                box.Visible = false
            end

            if onScreenHead then
                local screenVec = Vector2.new(headPos.X, headPos.Y)
                local distToCenter = (screenVec - center).Magnitude
                if distToCenter <= fovRadius then
                    -- inside FOV circle - consider for aimbot
                    local distMouse = (screenVec - mousePos).Magnitude
                    if distMouse < nearestDist then
                        nearestDist = distMouse
                        nearest = plr
                    end
                end
            end
        else
            box.Visible = false
        end
    end

    -- update aimLine: point from screen center to nearest player's head (within FOV)
    if nearest and ESP_ENABLED then
        local nchar = nearest.Character
        if nchar and nchar:FindFirstChild("Head") then
            local headPos, onScreen = Camera:WorldToViewportPoint(nchar.Head.Position)
            if onScreen then
                local centerScreen = center
                local targetPos = Vector2.new(headPos.X, headPos.Y)
                local delta = targetPos - centerScreen
                aimLine.Visible = true
                aimLine.Size = UDim2.new(0, 2, 0, math.max(4, delta.Magnitude))
                aimLine.Position = UDim2.new(0, centerScreen.X, 0, centerScreen.Y)
                aimLine.Rotation = math.deg(math.atan2(delta.Y, delta.X)) + 90

                -- change box border color: red for targeted, white for others
                for plr, box in pairs(playerBoxes) do
                    if plr == nearest then
                        box.BorderColor3 = Color3.new(1,0,0)
                    else
                        box.BorderColor3 = Color3.new(1,1,1)
                    end
                end
            else
                aimLine.Visible = false
            end
        else
            aimLine.Visible = false
        end
    else
        aimLine.Visible = false
        for _, box in pairs(playerBoxes) do
            box.BorderColor3 = Color3.new(1,1,1)
        end
    end
end)

