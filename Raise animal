-- 🧠 ระบบสลับสถานะ
local autoPress = false
mfBtn.MouseButton1Click:Connect(function()
	autoPress = not autoPress
	if autoPress then
		mfBtn.Text = "ON"
		mfBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		while autoPress do
			keypress(Enum.KeyCode.A)
			task.wait(0.1)
			keyrelease(Enum.KeyCode.A)
			task.wait(0.1)
			keypress(Enum.KeyCode.D)
			task.wait(0.1)
			keyrelease(Enum.KeyCode.D)
			task.wait(0.1)
		end
	else
		mfBtn.Text = "OFF"
		mfBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
end)

