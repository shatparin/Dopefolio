	miniFrame.Visible = not miniFrame.Visible
	if miniFrame.Visible then
		toggleMenuBtn.Text = "ON"
		toggleMenuBtn.BackgroundColor3 = Color3.fromRGB(0,200,100)
	else
		toggleMenuBtn.Text = "OFF"
		toggleMenuBtn.BackgroundColor3 = Color3.fromRGB(200,50,50)
	end
end)

-- Simulate Left/Right
local autoPress = false
mfBtn.MouseButton1Click:Connect(function()
	autoPress = not autoPress
	if autoPress then
		mfBtn.Text = "ON"
		mfBtn.BackgroundColor3 = Color3.fromRGB(0,200,100)
		coroutine.wrap(function()
			while autoPress do
				print("Simulate Left")
				wait(0.2)
				print("Simulate Right")
				wait(0.2)
			end
		end)()
	else
		mfBtn.Text = "OFF"
		mfBtn.BackgroundColor3 = Color3.fromRGB(200,50,50)
	end
end)

